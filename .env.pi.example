# pi-MVP test environment template
# Copy to .env.pi (gitignored) and fill in real keys.
# Supports either an in-built pi provider OR any OpenAI-compatible endpoint.

# --- Option A: built-in provider (e.g. Anthropic) ---
# PI_PROVIDER=anthropic                # default if unset
# PI_MODEL=claude-sonnet-4-6           # default if unset
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: OpenAI-compatible endpoint (DeepSeek / vLLM / Azure / etc.) ---
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-chat
# (Optional) PI_PROVIDER=deepseek      # name shown in UI/logs

# --- Optional overrides ---
# ZCLAUDIA_DATA_DIR=/tmp/zclaudia-pi-mvp/
# ZCLAUDIA_CHANNEL=pi-mvp
