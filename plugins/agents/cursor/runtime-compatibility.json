{
  "schemaVersion": 1,
  "runtime": "cursor",
  "executable": {
    "command": "cursor-agent",
    "versionArgs": ["--version"],
    "versionPattern": "(?:^|\\s)(\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)(?=\\s|$)"
  },
  "versionPolicy": {
    "testedMaximum": "2026.09.10-fd3934a"
  },
  "probe": {
    "kind": "acp",
    "args": ["acp"]
  },
  "live": {
    "kind": "acp-turn",
    "args": ["acp"],
    "prompt": "Reply exactly ZCLAUDIA_RUNTIME_COMPAT_OK. Do not use tools, files, shell commands, or MCP."
  },
  "distribution": {
    "vendorDependencies": true,
    "requiredRuntimePackages": ["@agentclientprotocol/sdk"]
  }
}
