{
  "name": "@zclaudia/desktop",
  "version": "0.1.1220",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm --filter @zclaudia/shared run build && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "rm -rf dist",
    "lint": "eslint src && node scripts/check-react-lifecycle-invariants.mjs",
    "check:lifecycle": "node scripts/check-react-lifecycle-invariants.mjs",
    "lint:fix": "eslint src --fix",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:tokens:check": "node scripts/gen-tokens.mjs --check",
    "gen:symbols": "node scripts/symbols/generate.mjs",
    "test": "node scripts/test-sequential.mjs",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:hooks": "vitest run --config=vitest.hooks.config.ts",
    "test:ui": "vitest run --config=vitest.ui.config.ts",
    "test:all": "corepack pnpm test:unit && corepack pnpm test:hooks && corepack pnpm test:ui",
    "test:parallel": "node scripts/test-parallel.mjs",
    "test:parallel:coverage": "node scripts/test-parallel.mjs --coverage",
    "test:parallel:fast": "node scripts/test-parallel-fast.mjs",
    "test:parallel:fast:coverage": "node scripts/test-parallel-fast.mjs --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:clear-cache": "rm -rf node_modules/.vitest-*"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@twemoji/api": "^17.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "@zclaudia/agent-transcript-kit": "^0.7.0",
    "@zclaudia/protocol": "^0.2.0",
    "@zclaudia/shared": "workspace:*",
    "ansi_up": "^6.0.6",
    "lucide-react": "^0.577.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.2.7",
    "remark-gfm": "^4.0.1",
    "rich-textarea": "^0.27.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/ui": "~4.0.18",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
