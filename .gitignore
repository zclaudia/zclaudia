# Impeccable installs a copy of itself for GitHub Copilot here. That copy is
# machine-local; the Claude Code one under .claude/ is ignored separately.
# Everything else in .github/ — workflows, actions, dependabot, and any
# CODEOWNERS or templates added later — is tracked by default. Denying the
# whole directory and allowlisting back silently drops new GitHub config,
# which is how the composite action and dependabot.yml both nearly got lost.
.github/skills/
.github/hooks/

.cursor/

.version

# Top-level runtime plugin installs (anchored to repo root so it does not
# match source dirs like shared/src/plugins/, server/src/application/plugins/).
# Built-in agent plugin source is tracked; generated output remains ignored.
/plugins/*
!/plugins/agents/

# Superpowers plugin generated docs
docs/superpowers/

.3rd-party/

.superpowers/
.claude/
.claire/
.codex/
.zcode/
.impeccable/

/artifacts/

.cache/runtime-artifacts/
