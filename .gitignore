# Top-level runtime plugin installs (anchored to repo root so it does not
# match source dirs like shared/src/plugins/, server/src/application/plugins/).
# First-party plugin workspace packages (plugins/*) are tracked source and
# must be excluded from this ignore individually.
/plugins/*
!/plugins/claude/
!/plugins/cursor/

