{
  "name": "@zclaudia/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core/*": {
      "import": "./dist/core/*.js",
      "types": "./dist/core/*.d.ts"
    },
    "./features/*": {
      "import": "./dist/features/*.js",
      "types": "./dist/features/*.d.ts"
    },
    "./interaction/*": {
      "import": "./dist/interaction/*.js",
      "types": "./dist/interaction/*.d.ts"
    },
    "./wire/*": {
      "import": "./dist/wire/*.js",
      "types": "./dist/wire/*.d.ts"
    },
    "./facade/*": {
      "import": "./dist/facade/*.js",
      "types": "./dist/facade/*.d.ts"
    },
    "./files": {
      "import": "./dist/files.js",
      "types": "./dist/files.d.ts"
    },
    "./plugin-types": {
      "import": "./dist/plugin-types.js",
      "types": "./dist/plugin-types.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/plugins/*.js",
      "types": "./dist/plugins/*.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@zclaudia/plugin-sdk": "^0.1.0",
    "@zclaudia/protocol": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
