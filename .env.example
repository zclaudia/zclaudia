# ZClaudia dev environment template.
# Copy to .env (committed-base) or .env.local (gitignored, your overrides) and fill in real keys.
# Loaded automatically by scripts/dev/start-app.sh (both tauri and standalone modes).

# --- pi-agent: built-in provider (e.g. Anthropic) ---
# PI_PROVIDER=anthropic                # default if unset
# PI_MODEL=claude-sonnet-4-6           # default if unset
# ANTHROPIC_API_KEY=sk-ant-...

# --- pi-agent: OpenAI-compatible endpoint (DeepSeek / vLLM / Azure / corporate proxy / etc.) ---
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-chat
# (Optional) PI_PROVIDER=deepseek      # name shown in UI/logs

# --- ZClaudia data isolation (override defaults) ---
# ZCLAUDIA_DATA_DIR=$HOME/.zclaudia-dev
# ZCLAUDIA_CHANNEL=dev

# Store the dedicated dev Gateway credential in ~/.zclaudia-dev/.env (chmod 600).
# scripts/dev/start-app.sh loads it after the repository env files; run-server.sh
# loads the same file. Use a separately issued backend credential for dev.
# GATEWAY_URL=http://your-gateway:3200
# GATEWAY_SECRET=zgb_...
# GATEWAY_NAME=mac-studio-dev
# GATEWAY_NAMESPACE=zclaudia
